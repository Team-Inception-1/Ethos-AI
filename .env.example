# Prisma / PostgreSQL (never point tests at production)
DATABASE_URL=postgresql://user:password@localhost:5432/ethos

# Community seed safety
COMMUNITY_SEED_ALLOWED_HOST=localhost
ENABLE_DEMO_DATA=false

# Explicit one-time maintenance switches (leave false normally)
VERIFY_PRIVATE_STORAGE=false
APPROVED_PRIVATE_DOCUMENT_MIGRATION=false

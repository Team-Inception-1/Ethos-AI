# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
#
# Get a Gemini API key: https://aistudio.google.com/app/apikey
# If left unset, provider-backed tools return 503 unless OFFLINE_DEMO=true.
GEMINI_API_KEY=
AI_SERVICE_API_TOKEN=
DATABASE_URL=
# JSON array; no browser origins are needed when using the Next.js gateway.
AI_ALLOWED_ORIGINS=[]
OFFLINE_DEMO=false

# Optional overrides:
# GEMINI_MODEL=gemini-3.6-flash
# ENVIRONMENT=development
# OPENALEX_API_KEY=

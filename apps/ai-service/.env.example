# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
#
# Get a Gemini API key: https://aistudio.google.com/app/apikey
# If left unset, the service falls back to a deterministic rule-based
# extractor (FakeAgreementLLM) so it still runs for local dev/demo purposes,
# just without real LLM-quality clause extraction.
GEMINI_API_KEY=

# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# ENVIRONMENT=development

DATABASE_URL=postgresql://user:password@localhost:5432/ethos

# Neon Auth
NEON_AUTH_BASE_URL=https://your-neon-auth-host.example/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
ENABLE_DEMO_AUTH=false

# Private S3-compatible storage
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint.example
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
ENABLE_LOCAL_PRIVATE_STORAGE=false

# Server-only AI connection
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_TOKEN=replace-with-a-long-random-service-token
NEXT_PUBLIC_OFFLINE_DEMO=false

# Signed sandbox payments; sandbox is rejected in production
ETHOS_PAYMENT_MODE=disabled
ETHOS_PAYMENT_SANDBOX_SECRET=replace-with-at-least-32-random-characters

# Tests only; the adapter refuses non-test environments
ENABLE_TEST_AUTH=false
